PORT=3210
PUBLIC_BASE_URL=http://localhost:3210
# gsm = Google Secret Manager (production) | mysql = local poster_accounts table (dev).
# Exactly one of the two, without surrounding spaces; blank means gsm; anything else fails at startup
TOKEN_SOURCE=gsm
# mysql only: file whose DATABASE_URL line is read when POSTER_MYSQL_URL is unset or blank.
# Leave it commented out to keep the built-in default path; an empty value is not treated as unset
# (it points at the repository directory instead)
# FINANZAS_ENV_PATH=
# mysql only: connection URL; when set and not blank it replaces the DATABASE_URL line read from
# FINANZAS_ENV_PATH. Unset or blank: that file is read at the first token lookup.
# With TOKEN_SOURCE=mysql a value that is not a valid URL fails at startup; with gsm it is ignored.
# MySQL errors name where the URL came from, never the URL itself
# POSTER_MYSQL_URL=
GCP_PROJECT_ID=
SECRET_PREFIX=poster-token-

# Account allow-list, comma-separated. Each entry: lowercase letters, digits and inner hyphens (1-63 chars).
# Default: cafe-01,...,cafe-10. When you set it, DEFAULT_WRITE_ACCOUNT and WRITE_DEFAULT_ACCOUNTS
# default to none, and every account they name must be in the list.
# POSTER_ACCOUNTS=cafe-01,cafe-02,cafe-03,cafe-04,cafe-05,cafe-06,cafe-07,cafe-08,cafe-09,cafe-10
# Account write tools use when `cuenta` is omitted; without one, `cuenta` is required on every write tool.
# It may be outside WRITE_DEFAULT_ACCOUNTS: writes to it then still need permitir_otra_cuenta: true
# DEFAULT_WRITE_ACCOUNT=cafe-04
# Accounts writable without permitir_otra_cuenta: true (comma-separated; may be empty).
# cafe-04 is the default only while POSTER_ACCOUNTS is unset; with a custom list the default is empty
# WRITE_DEFAULT_ACCOUNTS=cafe-04

# Time zone for "today" and default timestamps: any value Intl.DateTimeFormat takes. An IANA name is
# recommended; on current Node versions UTC offsets such as +05:00 and aliases such as EST also load
# (which ones load depends on the Node version). Letter case does not matter
# TIMEZONE=America/Merida
# Names shown in instructions, tool descriptions, the write guard and the authorization page
# (1-100 chars, no control or bidirectional formatting characters)
# OWNER_NAME=Roy
# NETWORK_NAME=RUSH Café
# MCP server name, /health, / and the authorization page title ([A-Za-z0-9._-], 1-64 chars, not trimmed)
# SERVICE_NAME=poster-rush
# `sub` claim of issued OAuth tokens ([A-Za-z0-9._@-], 1-64 chars, not trimmed).
# Tokens issued under an earlier value stay valid
# OAUTH_SUBJECT=roy

# openssl rand -hex 32
MCP_BEARER_TOKEN=
OAUTH_SIGNING_KEY=
OWNER_PASSPHRASE=
OAUTH_ALLOWED_REDIRECTS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback
AUDIT_DIR=./audit
